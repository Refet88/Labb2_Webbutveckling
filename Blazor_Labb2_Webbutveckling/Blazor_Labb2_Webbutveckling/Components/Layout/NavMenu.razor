@using Blazor_Labb2_Webbutveckling.Services
@inject AuthenticationService AuthenticationService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Blazor_Övning1</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        @if (!isAdmin && !isCustomer)
        {
            <NavLink href="/" class="nav-link" Match="NavLinkMatch.All">
                Login
            </NavLink>

            <NavLink href="register" class="nav-link" Match="NavLinkMatch.All">
                Register
            </NavLink>
        }
        else
        {

            @if (isAdmin)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="customers">
                        <span class="bi bi-list-nested" aria-hidden="true"></span> Customers
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="products">
                        <span class="bi bi-file-earmark" aria-hidden="true"></span> Products
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="orders">
                        <span class="bi bi-list-rich" aria-hidden="true"></span> Orders
                    </NavLink>
                </div>
            }
            @if (isCustomer)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="my-orders">
                        <span class="bi bi-list-rich" aria-hidden="true"></span> My Orders
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="createorder">
                        <span class="bi bi-list-rich" aria-hidden="true"></span> Create Order
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="update-customer">
                        <span class="bi bi-list-rich" aria-hidden="true"></span> Account Settings
                    </NavLink>
                </div>
            }

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="searchproducts">
                    <span class="bi bi-search" aria-hidden="true"></span> Search Products
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <button class="btn btn-danger w-100" @onclick="Logout">Logga ut</button>
            </div>
            <div class="nav-item px-3 text-light">
                @if (!string.IsNullOrEmpty(userName))
                {
                    <p>Logged in as: @userName</p>
                }
                else
                {
                    <p>Not logged in</p>
                }
            </div>
        }
    </nav>
</div>

@code {

    private bool isAdmin = false;
    private bool isCustomer = false;
    private string? userName;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var token = await AuthenticationService.GetToken();
            Console.WriteLine($"??Initial Token: {token}");
            userName = AuthenticationService.GetNameFromToken(token!);

            if (string.IsNullOrEmpty(token))
            {
                await AuthenticationService.ClearToken();
                Console.WriteLine("??No token found. Ready for login.");
            }
            else
            {
                try
                {
                    var role = AuthenticationService.GetRoleFromToken(token);
                    if (string.IsNullOrEmpty(role))
                    {
                        Console.WriteLine("No role found in token. Clearing token...");
                        await AuthenticationService.ClearToken();
                        token = null;
                    }
                    else
                    {
                        Console.WriteLine($"Role from Token: {role}");
                        isAdmin = role == "Admin";
                        isCustomer = role == "Customer";
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error processing token: {ex.Message}. Clearing token...");
                    await AuthenticationService.ClearToken();
                    token = null;
                }
            }

            StateHasChanged();
        }
    }



    public async Task Logout()
    {
        await AuthenticationService.LogoutAsync();
        await AuthenticationService.ClearToken();
        isAdmin = false;
        isCustomer = false;
        NavigationManager.NavigateTo("/", true);
    }
}