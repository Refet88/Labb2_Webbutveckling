@using Blazor_Labb2_Webbutveckling.Services
@inject AuthenticationService AuthenticationService
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">WebShop</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="flex-column">
        @if (!isAdmin && !isCustomer)
        {
            <NavLink href="/" class="nav-link" Match="NavLinkMatch.All">
                Login
            </NavLink>

            <NavLink href="register" class="nav-link" Match="NavLinkMatch.All">
                Register
            </NavLink>
        }
        else
        {
            <div class="nav-item px-3 mb-2" @onclick:stopPropagation="true">
                <ProductSearchBox IsAdmin="isAdmin" />
            </div>

            @if (isAdmin)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="customers">
                        <span class="bi bi-list-nested" aria-hidden="true"></span> Customers
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="products">
                        <span class="bi bi-file-earmark" aria-hidden="true"></span> Products
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="orders">
                        <span class="bi bi-list-rich" aria-hidden="true"></span> Orders
                    </NavLink>
                </div>
            }

            @if (isCustomer)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="customer-dashboard">
                        <span class="bi bi-house" aria-hidden="true"></span> Home
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="my-orders">
                        <span class="bi bi-list-rich" aria-hidden="true"></span> My Orders
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="createorder">
                        <span class="bi bi-list-rich" aria-hidden="true"></span> Create Order
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="update-customer">
                        <span class="bi bi-list-rich" aria-hidden="true"></span> Account Settings
                    </NavLink>
                </div>
            }

            <div class="nav-item px-3">
                <button class="btn btn-danger w-100" @onclick="Logout">Logga ut</button>
            </div>

            <div class="nav-item px-3 text-light">
                @if (!string.IsNullOrEmpty(userName))
                {
                    <p class="small mb-0">Inloggad: @userName</p>
                }
            </div>
        }
    </nav>
</div>

@code {
    private bool isAdmin;
    private bool isCustomer;
    private string? userName;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var token = await AuthenticationService.GetToken();
        userName = AuthenticationService.GetNameFromToken(token ?? string.Empty);

        if (string.IsNullOrEmpty(token))
        {
            await AuthenticationService.ClearToken();
            isAdmin = false;
            isCustomer = false;
        }
        else
        {
            var role = AuthenticationService.GetRoleFromToken(token);
            if (string.IsNullOrEmpty(role))
            {
                await AuthenticationService.ClearToken();
                isAdmin = false;
                isCustomer = false;
            }
            else
            {
                isAdmin = role == "Admin";
                isCustomer = role == "Customer";
            }
        }

        StateHasChanged();
    }

    public async Task Logout()
    {
        await AuthenticationService.LogoutAsync();
        await AuthenticationService.ClearToken();
        isAdmin = false;
        isCustomer = false;
        NavigationManager.NavigateTo("/", true);
    }
}
