@page "/"
@using Blazor_Labb2_Webbutveckling.Models
@using Blazor_Labb2_Webbutveckling.Services
@inject NavigationManager NavigationManager
@inject AuthenticationService AuthenticationService
@rendermode InteractiveServer

<h3>Login</h3>

<EditForm Model="loginModel" OnValidSubmit="SubmitLogin">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Username or Email:</label>
        <InputText @bind-Value="loginModel.Username" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Password:</label>
        <InputText @bind-Value="loginModel.Password" type="password" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary w-100">Login</button>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">
            <b>Error:</b> @errorMessage
        </div>
    }
</EditForm>

@code {
    private LoginModel loginModel = new LoginModel();
    private string? errorMessage;

    private async Task SubmitLogin()
    {
        try
        {
            var success = await AuthenticationService.LoginAsync(loginModel.Username, loginModel.Password);
            if (success)
            {
                var token = await AuthenticationService.GetToken();
                if (!string.IsNullOrEmpty(token))
                {
                    var role = AuthenticationService.GetRoleFromToken(token);

                    // Navigera baserat på rollen
                    if (role == "Admin")
                    {
                        NavigationManager.NavigateTo("/admin-dashboard", true);
                    }
                    else if (role == "Customer")
                    {
                        NavigationManager.NavigateTo("/customer-dashboard", true);
                    }
                    else
                    {
                        errorMessage = "Unrecognized role. Contact support.";
                    }
                }
                else
                {
                    errorMessage = "Token is missing or invalid.";
                }
            }
            else
            {
                errorMessage = "Login failed. Please check your credentials.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
    }
}
