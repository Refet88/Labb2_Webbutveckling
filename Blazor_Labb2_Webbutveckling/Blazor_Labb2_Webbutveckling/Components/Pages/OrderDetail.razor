@page "/orderdetails/{orderId:int}"
@using Blazor_Labb2_Webbutveckling.Models
@using Blazor_Labb2_Webbutveckling.Services
@inject OrderService OrderService
@inject NavigationManager NavigationManager
@inject AuthenticationService AuthenticationService
@rendermode InteractiveServer

@code {
    [Parameter]
    public int OrderId { get; set; }

    private Order? order;
    private string? errorMessage;
    private bool isFirstRender = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isFirstRender)
        {
            isFirstRender = false;

            var token = await AuthenticationService.GetToken();
            if (string.IsNullOrEmpty(token))
            {
                errorMessage = "You are not logged in.";
                NavigationManager.NavigateTo("/login", true);
                return;
            }

            try
            {
                order = await OrderService.GetOrderById(OrderId);

                if (order == null)
                {
                    errorMessage = "The order could not be displayed. Check if you have the correct permissions or if the order exists.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to load order details: {ex.Message}";
            }

            StateHasChanged();
        }
    }

    private decimal GetTotalSum()
    {
        if (order == null || order.OrderItems == null)
        {
            return 0;
        }

        return order.OrderItems.Sum(item => item.Price * item.Quantity);
    }

    private async Task NavigateBack()
    {
        var token = await AuthenticationService.GetToken();
        if (string.IsNullOrEmpty(token))
        {
            NavigationManager.NavigateTo("/", true);
            return;
        }

        var role = AuthenticationService.GetRoleFromToken(token);
        if (role == "Customer")
        {
            NavigationManager.NavigateTo("/my-orders", true);
        }
        else if (role == "Admin")
        {
            NavigationManager.NavigateTo("/orders", true);
        }
    }
}

<button class="btn btn-secondary mt-3" @onclick="NavigateBack">Back</button>

<h3>Order Details</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}
else if (order == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Order ID</dt>
        <dd class="col-sm-10">@order.OrderId</dd>
        <dt class="col-sm-2">Customer ID</dt>
        <dd class="col-sm-10">@order.CustomerId</dd>
        <dt class="col-sm-2">Order Date</dt>
        <dd class="col-sm-10">@order.OrderDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-2">Customer Name</dt>
        <dd class="col-sm-10">@order.Customer?.FirstName @order.Customer?.LastName</dd>
        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@order.Customer?.Street, @order.Customer?.ZipCode @order.Customer?.City</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@order.Customer?.Email</dd>
    </dl>
    <h4>Order Items</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Product ID</th>
                <td>Product Name</td>
                <th>Quantity</th>
                <td>Price</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in order.OrderItems)
            {
                <tr>
                    <td>@item.ProductNumber</td>
                    <td>@item.Product!.Name</td>
                    <td>@item.Quantity</td>
                    <td>@item.Price</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end"><strong>Total:</strong></td>
                <td><strong>@GetTotalSum()</strong> SEK</td>
            </tr>
        </tfoot>
    </table>
}