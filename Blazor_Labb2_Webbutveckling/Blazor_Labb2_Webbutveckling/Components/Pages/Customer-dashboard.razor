@page "/customer-dashboard"
@using Blazor_Labb2_Webbutveckling.Models
@using Blazor_Labb2_Webbutveckling.Services
@inject ProductService ProductService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<h3>Välkommen</h3>

<p class="text-muted">Sök produkter i menyn till vänster, eller handla via Create Order.</p>

@if (!string.IsNullOrEmpty(message))
{
    <p class="alert alert-danger">@message</p>
}

@if (carouselProducts.Count == 0)
{
    <p>Inga produkter med bilder att visa.</p>
}
else
{
    var current = carouselProducts[carouselIndex];
    var thumb = current.Images?
        .FirstOrDefault(i => i.IsPrimary)
        ?? current.Images?.OrderBy(i => i.SortOrder).FirstOrDefault();

    <div class="border rounded p-3 mb-3 text-center">
        @if (thumb != null)
        {
            <img src="@ImageSrc(thumb.ImageUrl)" alt="@current.Name"
                 class="img-fluid" style="max-height: 320px; object-fit: contain;" />
        }
        else
        {
            <img src="/images/Noimage.png" alt="Ingen bild" class="img-fluid" style="max-height: 320px;" />
        }
        <h4 class="mt-2">@current.Name</h4>
        <p>@current.Price.ToString("N2") kr</p>
        <div class="d-flex justify-content-center gap-2 mt-2">
            <button class="btn btn-outline-secondary" @onclick="PreviousProduct" disabled="@(carouselIndex == 0)">Föregående</button>
            <button class="btn btn-outline-secondary" @onclick="NextProduct" disabled="@(carouselIndex >= carouselProducts.Count - 1)">Nästa</button>
        </div>
        <a class="btn btn-primary mt-2" href="/product/@current.ProductNumber">Visa produkt</a>
    </div>
}

<div class="d-flex gap-2">
    <a class="btn btn-secondary" href="/createorder">Handla</a>
</div>

@code {
    private List<Product> carouselProducts = new();
    private int carouselIndex;
    private string message = string.Empty;

    private const string ApiBaseUrl = "https://localhost:7018";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await ProductService.GetAllProducts();

            carouselProducts = all
                .Where(p => !p.IsDiscontinued)
                .Where(p => p.Images != null && p.Images.Any())
                .ToList();

            carouselIndex = 0;
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    private string ImageSrc(string url) =>
        url.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? url
            : ApiBaseUrl + url;

    private void PreviousProduct()
    {
        if (carouselIndex > 0)
            carouselIndex--;
    }

    private void NextProduct()
    {
        if (carouselIndex < carouselProducts.Count - 1)
            carouselIndex++;
    }
}
